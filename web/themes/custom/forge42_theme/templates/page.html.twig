<div class="site-shell">
  <header class="site-header">
    <a class="brand" href="{{ path('<front>') }}" aria-label="Forge42 Solutions home">
      <span class="brand-mark">F</span>
      <span><strong>FORGE<span>42</span></strong><small>SOLUTIONS</small></span>
    </a>
    <nav aria-label="Primary navigation">{{ page.primary_menu }}</nav>
    <a class="button button--accent" href="/contact">Schedule a Consultation</a>
  </header>

  {% if is_front %}
  <main>
    <section class="hero">
      <div class="hero__content">
        <p class="eyebrow">Engineering confidence</p>
        <h1>Enterprise Technology.<br><span>Done Right</span><br>the First Time.</h1>
        <p>Forge42 Solutions helps organizations modernize mission-critical platforms through enterprise engineering, artificial intelligence, cloud technologies, and strategic consulting.</p>
        <div class="actions"><a class="button button--accent" href="/solutions">Explore Our Solutions</a><a class="button button--outline" href="/contact">Schedule a Consultation</a></div>
      </div>
      <div class="hero__visual" aria-hidden="true"><div class="network"></div></div>
    </section>

    <section class="trust"><h2>We make complex technology manageable.</h2><p>Modernize legacy systems, reduce technical debt, apply AI responsibly, and build secure platforms designed for long-term success.</p></section>

    <section class="section"><p class="eyebrow">Solutions that drive results</p><h2>Comprehensive Solutions. Measurable Outcomes.</h2><div class="card-grid">
      {% set cards = [
        ['Enterprise Modernization','Transform aging platforms into secure, scalable, future-ready systems.'],
        ['Enterprise Drupal Engineering','Architect, migrate, and optimize mission-critical Drupal platforms.'],
        ['Artificial Intelligence Enablement','Apply practical AI to automate processes and improve decisions.'],
        ['Cloud Transformation','Build secure, scalable AWS cloud environments and modern DevOps.'],
        ['Digital Operations','Proactive monitoring, maintenance, security, and optimization.'],
        ['Compliance & Accessibility','Build WCAG, Section 508, security, and governance into delivery.'],
        ['Integration Services','Connect systems and automate data flow across the enterprise.'],
        ['Engineering Advisory','Strategic architecture, roadmaps, and fractional CTO guidance.']
      ] %}
      {% for card in cards %}<article class="card"><div class="icon">{{ loop.index }}</div><h3>{{ card[0] }}</h3><p>{{ card[1] }}</p><a href="/solutions">Learn more →</a></article>{% endfor %}
    </div></section>

    <section class="framework"><div><p class="eyebrow">Our proven approach</p><h2>The Forge42 Engineering Framework™</h2><p>Every engagement follows a structured methodology that delivers predictable results and long-term value.</p></div><ol>{% for step in ['Discover','Architect','Engineer','Validate','Launch','Optimize'] %}<li><span>{{ loop.index }}</span><strong>{{ step }}</strong></li>{% endfor %}</ol></section>

    <section class="cta"><div><p class="eyebrow">Not sure where to start?</p><h2>Forge42 Modernization Assessment™</h2><p>We evaluate architecture, accessibility, security, performance, cloud, and AI opportunities, then deliver a prioritized roadmap.</p></div><a class="button button--accent" href="/contact">Start a Conversation</a></section>
    {{ page.content }}
  </main>
  {% else %}
  <main class="section content-page">{{ page.highlighted }}{{ page.content }}</main>
  {% endif %}

  <footer class="site-footer"><strong>Forge42 Solutions</strong><span>Enterprise Technology. Done Right the First Time.</span><span>© {{ 'now'|date('Y') }}</span></footer>
</div>
